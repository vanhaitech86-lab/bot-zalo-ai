{
  "version": 2,
  "name": "haitech-bot-omnichannel",
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "*.svg",
      "use": "@vercel/static"
    },
    {
      "src": "haitech-chat-widget.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/facebook-webhook",
      "dest": "/api/facebook-webhook.js"
    },
    {
      "src": "/api/zalo-webhook",
      "dest": "/api/zalo-webhook.js"
    },
    {
      "src": "/api/website-chat",
      "dest": "/api/website-chat.js"
    },
    {
      "src": "/api/sync-leads",
      "dest": "/api/sync-leads.js"
    },
    {
      "src": "/haitech-chat-widget.js",
      "dest": "/haitech-chat-widget.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
